{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "watchPatterns": ["/master-calendar-platform/apps/api/**", "/master-calendar-platform/packages/**", "/master-calendar-platform/package-lock.json"]
  },
  "deploy": {
    "startCommand": "npm run worker -w @mcp/api",
    "restartPolicyType": "ALWAYS"
  }
}
