# --- Database (Supabase-hosted Postgres, used purely as a DB) ---
# Runtime connection. On Supabase use the pooler (port 6543, ?pgbouncer=true) for the API.
DATABASE_URL="postgresql://mcp:mcp@localhost:5432/mcp_dev"
# Direct (non-pooled, port 5432) connection used by `prisma migrate`. Same as DATABASE_URL locally.
DIRECT_URL="postgresql://mcp:mcp@localhost:5432/mcp_dev"
# Scratch DB for generating migrations locally (never point this at real data).
SHADOW_DATABASE_URL="postgresql://mcp:mcp@localhost:5432/mcp_shadow"

# --- App-layer encryption for OAuth tokens / feed credentials (AES-256-GCM) ---
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENCRYPTION_KEY=""

# --- Supabase Storage (schedule photos; private bucket, signed URLs) ---
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="schedule-photos"

# --- Google Calendar OAuth (step 4) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3001/integrations/google/callback"

# --- Vision model for photo extraction (step 6) ---
ANTHROPIC_API_KEY=""

# --- Web app ---
WEB_ORIGIN="http://localhost:5173"

# --- Local seed only: password assigned to every seeded dev user ---
SEED_USER_PASSWORD="password123"
