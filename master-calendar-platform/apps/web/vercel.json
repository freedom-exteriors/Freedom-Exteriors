{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://YOUR-API.up.railway.app/:path*"
    },
    {
      "source": "/((?!api/|assets/|sw.js|manifest.webmanifest|icon.svg).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/wall/:path*",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
