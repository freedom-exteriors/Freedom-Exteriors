{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://YOUR-API.up.railway.app/:path*" },
    { "source": "/((?!api/|assets/|sw.js|manifest.webmanifest|icon.svg).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
