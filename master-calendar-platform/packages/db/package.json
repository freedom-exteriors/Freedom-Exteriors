{
  "name": "@mcp/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./seed-templates": "./seed-templates/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "reset": "prisma migrate reset --force",
    "seed": "tsx prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@mcp/shared-types": "0.1.0",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "dotenv": "^16.5.0",
    "prisma": "7.10.0",
    "rrule": "^2.8.1",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  }
}
