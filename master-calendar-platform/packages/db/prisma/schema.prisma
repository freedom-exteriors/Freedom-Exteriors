// Master Calendar Platform — one engine, three verticals (family / student / business).
// Nothing in the engine branches on `Workspace.vertical`; only seed templates and UI copy do.
// All DateTime columns are timestamptz and hold UTC.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Workspaces & auth ─────────────────────────

enum WorkspaceVertical {
  family
  student
  business
}

// home   = a household / student / business's own space.
// circle = a shared planning space between several homes (carpool group, team parents,
//          two families planning a trip). Same tables, same auth boundary; its
//          Participants stand for the member homes (see Participant.linkedWorkspaceId).
// Joining a circle never exposes a home's own calendar — only what's put in the circle.
enum WorkspaceKind {
  home
  circle
}

model Workspace {
  id                  String                  @id @default(uuid()) @db.Uuid // random v4 — doubles as the unguessable wall-display URL segment (v1 only)
  name                String
  vertical            WorkspaceVertical
  kind                WorkspaceKind           @default(home)
  // IANA zone. Day/week boundaries, availability windows, reminder dates and
  // "leave by 5:12 PM" all resolve in this zone; storage stays UTC.
  timeZone            String                  @default("America/Chicago")
  participants        Participant[]
  contacts            Contact[]
  calendarSources     CalendarSource[]
  automationRules     AutomationRule[]
  tasks               Task[]
  eventTagDefinitions EventTagDefinition[]
  uploadedSchedules   UploadedScheduleImage[]
  memberships         WorkspaceMembership[]
  taskLists           TaskList[]
  shoppingLists       ShoppingList[]
  goals               Goal[]
  recurringReminders  RecurringReminder[]
  invites             WorkspaceInvite[]
  places              Place[]
  oauthConnections    OAuthConnection[]
  oauthStates         OAuthState[]
  notifications       Notification[]
  // In circles: the Participant rows that represent this home.
  representedIn       Participant[]           @relation("LinkedWorkspace")
  createdAt           DateTime                @default(now()) @db.Timestamptz(3)
}

model User {
  id                  String                  @id @default(uuid()) @db.Uuid
  email               String                  @unique // stored lowercased by the app
  passwordHash        String // argon2id
  // Opt-in: time-sensitive alerts also go by email (needs RESEND_API_KEY on the server).
  emailNotifications  Boolean                 @default(false)
  memberships         WorkspaceMembership[]
  sessions            Session[]
  notifications       Notification[]
  pushSubscriptions   PushSubscription[]
  uploadedSchedules   UploadedScheduleImage[]
  invitesSent         WorkspaceInvite[]
  oauthConnections    OAuthConnection[]
  oauthStates         OAuthState[]
  // Attribution only ("added by Sam") — never used for authorization.
  tasksCreated        Task[]                  @relation("TaskCreatedBy")
  tasksCompleted      Task[]                  @relation("TaskCompletedBy")
  shoppingItemsAdded  ShoppingItem[]          @relation("ShoppingItemAddedBy")
  shoppingItemsBought ShoppingItem[]          @relation("ShoppingItemCheckedBy")
  createdAt           DateTime                @default(now()) @db.Timestamptz(3)
}

// Server-side session store. `id` is the SHA-256 of the session token handed to the
// client, so a DB leak doesn't yield usable session tokens.
model Session {
  id        String   @id
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId])
}

enum MembershipRole {
  owner
  member
  viewer
}

// The authorization boundary: every API query is scoped through the caller's memberships.
model WorkspaceMembership {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @db.Uuid
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId   String         @db.Uuid
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  participantId String?        @unique @db.Uuid // the Participant this login "is", if any — at most one login per participant
  participant   Participant?   @relation(fields: [participantId], references: [id], onDelete: SetNull)
  role          MembershipRole
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

// Invite link / email to join a workspace: a second parent into a home, or a family
// into a circle. Only the SHA-256 of the token is stored.
model WorkspaceInvite {
  id              String         @id @default(uuid()) @db.Uuid
  workspaceId     String         @db.Uuid
  workspace       Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tokenHash       String         @unique
  email           String? // optional: restrict to this address
  role            MembershipRole
  // Home invites only: the Participant the invitee will "be" (e.g. Maya's own login).
  participantId   String?        @db.Uuid
  participant     Participant?   @relation(fields: [participantId], references: [id], onDelete: Cascade)
  invitedByUserId String         @db.Uuid
  invitedBy       User           @relation(fields: [invitedByUserId], references: [id], onDelete: Cascade)
  expiresAt       DateTime       @db.Timestamptz(3)
  acceptedAt      DateTime?      @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)

  @@index([workspaceId])
}

// ───────────────────────── People ─────────────────────────

model Participant {
  id                          String               @id @default(uuid()) @db.Uuid
  workspaceId                 String               @db.Uuid
  workspace                   Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name                        String
  color                       String // hex, e.g. "#3B82F6"
  // Circles only: the home workspace this participant stands for ("Chen family").
  linkedWorkspaceId           String?              @db.Uuid
  linkedWorkspace             Workspace?           @relation("LinkedWorkspace", fields: [linkedWorkspaceId], references: [id], onDelete: SetNull)
  events                      Event[]
  assignedTasks               Task[]               @relation("AssignedTasks")
  scheduledTasks              Task[]               @relation("ScheduledTasks")
  defaultForSources           CalendarSource[]     @relation("DefaultParticipant")
  membership                  WorkspaceMembership?
  goals                       Goal[]
  reminders                   RecurringReminder[]
  // Where this person starts from when no earlier event says otherwise (usually home).
  homePlaceId                 String?              @db.Uuid
  homePlace                   Place?               @relation("ParticipantHome", fields: [homePlaceId], references: [id], onDelete: SetNull)
  // Can be handed errands and driving; kids usually can't. Leave-by alerts go to drivers.
  canDrive                    Boolean              @default(false)
  maxPlannedTaskMinutesPerDay Int                  @default(90) // the organizer never plans more than this
  availability                AvailabilityWindow[]
  invites                     WorkspaceInvite[]
  drivingEvents               Event[]              @relation("EventDriver")
  departureAlerts             DepartureAlert[]
  createdAt                   DateTime             @default(now()) @db.Timestamptz(3)

  @@unique([workspaceId, linkedWorkspaceId])
  @@index([workspaceId])
}

model Contact {
  id           String         @id @default(uuid()) @db.Uuid
  workspaceId  String         @db.Uuid
  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name         String
  role         String // free text; suggested values come from the vertical's seed template
  organization String?
  phone        String?
  email        String?
  events       EventContact[]
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)

  @@index([workspaceId])
}

// ───────────────────────── Calendar sources & events ─────────────────────────

enum CalendarSourceType {
  google
  caldav
  calendly
  ics_feed
  photo_extraction // synthetic source attributing events confirmed from an uploaded photo
}

model CalendarSource {
  id                   String              @id @default(uuid()) @db.Uuid
  workspaceId          String              @db.Uuid
  workspace            Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name                 String? // display label, e.g. "U12 Soccer (SportsEngine)"
  defaultParticipantId String?             @db.Uuid
  defaultParticipant   Participant?        @relation("DefaultParticipant", fields: [defaultParticipantId], references: [id], onDelete: SetNull)
  type                 CalendarSourceType
  feedUrl              String?
  // AES-256-GCM ciphertext (app-layer, key from env) — never plaintext.
  // Google (and future OAuth) sources: which account + which of its calendars. Tokens live
  // on the connection, shared by every calendar picked from that account.
  oauthConnectionId    String?             @db.Uuid
  oauthConnection      OAuthConnection?    @relation(fields: [oauthConnectionId], references: [id], onDelete: Cascade)
  externalCalendarId   String?
  feedUsernameEnc      Bytes?
  feedPasswordEnc      Bytes?
  lastSyncedAt         DateTime?           @db.Timestamptz(3)
  // ─ Sync job state ─ (feeds are polled at most every 30 min; SportsEngine only
  // refreshes about that often anyway)
  nextSyncAt           DateTime?           @db.Timestamptz(3)
  lastSyncError        String?
  lastSyncStats        Json? // { created, updated, deleted, skipped }
  httpEtag             String? // conditional GET: unchanged feeds cost one 304
  httpLastModified     String?
  // Tag applied to new events from this feed (e.g. a school feed → "school"). Set by a
  // person; never inferred. Events keep any tag a person picks later.
  defaultEventTagId    String?             @db.Uuid
  defaultEventTag      EventTagDefinition? @relation("SourceDefaultTag", fields: [defaultEventTagId], references: [id], onDelete: SetNull)
  createdAt            DateTime            @default(now()) @db.Timestamptz(3)
  events               Event[]

  @@unique([oauthConnectionId, externalCalendarId])
  @@index([workspaceId])
  @@index([type, nextSyncAt])
}

model EventTagDefinition {
  id                String           @id @default(uuid()) @db.Uuid
  workspaceId       String           @db.Uuid
  workspace         Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  key               String // stable identifier referenced by automation rules, e.g. "practice"
  label             String
  color             String?
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  events            Event[]
  automationRules   AutomationRule[]
  defaultForSources CalendarSource[] @relation("SourceDefaultTag")

  @@unique([workspaceId, key])
}

model Event {
  id                   String              @id @default(uuid()) @db.Uuid
  calendarSourceId     String              @db.Uuid
  calendarSource       CalendarSource      @relation(fields: [calendarSourceId], references: [id], onDelete: Cascade)
  participantId        String?             @db.Uuid // null = unassigned until claimed
  participant          Participant?        @relation(fields: [participantId], references: [id], onDelete: SetNull)
  eventTagId           String?             @db.Uuid // null = untagged
  eventTag             EventTagDefinition? @relation(fields: [eventTagId], references: [id], onDelete: SetNull)
  externalUid          String
  // "" for non-recurring events (NOT null): Postgres treats NULLs as distinct in unique
  // constraints, so a nullable column here would let the upsert key silently duplicate
  // every non-recurring event on each sync. Recurring instances use the instance's
  // original start (RECURRENCE-ID / originalStartTime) as an ISO-8601 UTC string.
  externalRecurrenceId String              @default("")
  title                String
  startTime            DateTime            @db.Timestamptz(3)
  endTime              DateTime            @db.Timestamptz(3)
  allDay               Boolean             @default(false)
  location             String?
  // Resolved from `location` by geocoding (or picked by a person); needed for travel times.
  placeId              String?             @db.Uuid
  place                Place?              @relation(fields: [placeId], references: [id], onDelete: SetNull)
  // Who's taking the participant there. Defaults to the participant if they drive.
  driverParticipantId  String?             @db.Uuid
  driver               Participant?        @relation("EventDriver", fields: [driverParticipantId], references: [id], onDelete: SetNull)
  departureAlerts      DepartureAlert[]
  rawSourceData        Json
  contacts             EventContact[]
  tasks                Task[]
  createdAt            DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime            @updatedAt @db.Timestamptz(3)

  @@unique([calendarSourceId, externalUid, externalRecurrenceId])
  @@index([calendarSourceId, startTime])
  @@index([startTime])
}

model EventContact {
  eventId   String  @db.Uuid
  contactId String  @db.Uuid
  event     Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([eventId, contactId])
}

// ───────────────────────── Automation & tasks ─────────────────────────

enum ActionType {
  create_reminder
  flag_unassigned_task
}

model AutomationRule {
  id                  String             @id @default(uuid()) @db.Uuid
  workspaceId         String             @db.Uuid
  workspace           Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  eventTagId          String             @db.Uuid
  eventTag            EventTagDefinition @relation(fields: [eventTagId], references: [id], onDelete: Cascade)
  timingOffsetMinutes Int // minutes before event start the task becomes due (negative = after)
  actionType          ActionType
  actionPayload       Json // e.g. { "titleTemplate": "Pack gear for {{title}}" }
  enabled             Boolean            @default(true)
  tasks               Task[]
  createdAt           DateTime           @default(now()) @db.Timestamptz(3)

  @@index([workspaceId])
}

enum TaskLocationKind {
  home // needs to be done at home (fix the hinge)
  errand // at `placeId` (Goodwill drop-off, Target pickup)
  anywhere // a phone call, an online form
}

enum TaskScheduleStatus {
  suggested
  accepted
}

enum TaskPriority {
  low
  normal
  high
}

// The one to-do primitive. A task can come from a person (a honey-do item), from the
// rule engine (automationRuleId + eventId), or from a recurring reminder
// (recurringReminderId + occurrenceDate). It can optionally sit on a TaskList and/or
// count toward a Goal. Tasks with no list show up in the dashboard's general task view.
model Task {
  id                     String              @id @default(uuid()) @db.Uuid
  workspaceId            String              @db.Uuid
  workspace              Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  taskListId             String?             @db.Uuid
  taskList               TaskList?           @relation(fields: [taskListId], references: [id], onDelete: SetNull)
  goalId                 String?             @db.Uuid // a step toward this goal
  goal                   Goal?               @relation(fields: [goalId], references: [id], onDelete: SetNull)
  eventId                String?             @db.Uuid
  event                  Event?              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  // Set when generated by the rule engine; with eventId it makes the scheduled job idempotent.
  automationRuleId       String?             @db.Uuid
  automationRule         AutomationRule?     @relation(fields: [automationRuleId], references: [id], onDelete: SetNull)
  // Set when generated by a recurring/seasonal reminder, for the occurrence it covers.
  recurringReminderId    String?             @db.Uuid
  recurringReminder      RecurringReminder?  @relation(fields: [recurringReminderId], references: [id], onDelete: SetNull)
  occurrenceDate         DateTime?           @db.Date
  assignedParticipantId  String?             @db.Uuid
  assignedParticipant    Participant?        @relation("AssignedTasks", fields: [assignedParticipantId], references: [id], onDelete: SetNull)
  title                  String
  notes                  String?
  priority               TaskPriority        @default(normal)
  position               Float               @default(0) // manual ordering within a list
  dueAt                  DateTime?           @db.Timestamptz(3)
  // ─ Schedule organizer inputs ─
  estimatedMinutes       Int? // required for the organizer to place it
  locationKind           TaskLocationKind    @default(home)
  placeId                String?             @db.Uuid // where an errand happens
  place                  Place?              @relation(fields: [placeId], references: [id], onDelete: SetNull)
  // ─ Schedule organizer output ─ suggested slots are replaced on every re-plan;
  // accepted ones are treated as fixed, like an event.
  scheduledStart         DateTime?           @db.Timestamptz(3)
  scheduledEnd           DateTime?           @db.Timestamptz(3)
  scheduleStatus         TaskScheduleStatus?
  scheduleReason         String? // "Near Target after practice: +6 min detour"
  // Who the slot is for. For unassigned to-dos this is only a suggestion; accepting the
  // slot makes it the assignment.
  scheduledParticipantId String?             @db.Uuid
  scheduledParticipant   Participant?        @relation("ScheduledTasks", fields: [scheduledParticipantId], references: [id], onDelete: SetNull)
  completedAt            DateTime?           @db.Timestamptz(3)
  createdByUserId        String?             @db.Uuid
  createdBy              User?               @relation("TaskCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  completedByUserId      String?             @db.Uuid
  completedBy            User?               @relation("TaskCompletedBy", fields: [completedByUserId], references: [id], onDelete: SetNull)
  createdAt              DateTime            @default(now()) @db.Timestamptz(3)

  @@unique([automationRuleId, eventId])
  @@unique([recurringReminderId, occurrenceDate])
  @@index([workspaceId, completedAt])
  @@index([taskListId, position])
  @@index([goalId])
}

// A named to-do list: "Honey-do", "Chores", "Packing list", "Maintenance".
model TaskList {
  id           String              @id @default(uuid()) @db.Uuid
  workspaceId  String              @db.Uuid
  workspace    Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  key          String? // set for template-seeded lists so reminders can target them; null for user-made lists
  name         String
  // Lets `viewer` members (e.g. kids) add and check off items here, while
  // everything else stays read-only for them.
  viewerCanAdd Boolean             @default(false)
  position     Float               @default(0)
  tasks        Task[]
  reminders    RecurringReminder[]
  archivedAt   DateTime?           @db.Timestamptz(3)
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)

  @@unique([workspaceId, key])
}

// ───────────────────────── Shopping ─────────────────────────

enum Retailer {
  amazon
  target
  walmart
  kroger
  instacart
}

model ShoppingList {
  id                String         @id @default(uuid()) @db.Uuid
  workspaceId       String         @db.Uuid
  workspace         Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  key               String?
  name              String // "Groceries", "Costco run", "Dorm supplies", "Supply order"
  preferredRetailer Retailer?
  // A store to pick this list up from; turns the list into an errand the organizer can plan.
  placeId           String?        @db.Uuid
  place             Place?         @relation(fields: [placeId], references: [id], onDelete: SetNull)
  viewerCanAdd      Boolean        @default(true)
  position          Float          @default(0)
  items             ShoppingItem[]
  archivedAt        DateTime?      @db.Timestamptz(3)
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)

  @@unique([workspaceId, key])
}

model ShoppingItem {
  id              String       @id @default(uuid()) @db.Uuid
  shoppingListId  String       @db.Uuid
  shoppingList    ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
  name            String
  quantity        String? // free text: "2", "1 lb", "family size"
  category        String? // store section; suggestions come from the vertical template
  notes           String?
  // A staple stays on the list after it's checked off, so it can be re-added in one tap.
  isStaple        Boolean      @default(false)
  // Product identifiers used for retailer handoff, keyed by Retailer, e.g.
  // { "amazon": { "asin": "B00..." }, "target": { "tcin": "13..." }, "kroger": { "upc": "..." } }
  retailerRefs    Json?
  position        Float        @default(0)
  checkedAt       DateTime?    @db.Timestamptz(3)
  addedByUserId   String?      @db.Uuid
  addedBy         User?        @relation("ShoppingItemAddedBy", fields: [addedByUserId], references: [id], onDelete: SetNull)
  checkedByUserId String?      @db.Uuid
  checkedBy       User?        @relation("ShoppingItemCheckedBy", fields: [checkedByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)

  @@index([shoppingListId, checkedAt])
}

// ───────────────────────── Goals ─────────────────────────

enum GoalHorizon {
  short_term // weeks to a few months
  long_term // a year or more
}

enum GoalStatus {
  active
  achieved
  dropped
}

// Progress = completed Tasks with this goalId / all Tasks with this goalId (the milestones).
model Goal {
  id            String       @id @default(uuid()) @db.Uuid
  workspaceId   String       @db.Uuid
  workspace     Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  participantId String?      @db.Uuid // null = shared goal for the whole workspace
  participant   Participant? @relation(fields: [participantId], references: [id], onDelete: SetNull)
  title         String
  description   String?
  horizon       GoalHorizon
  status        GoalStatus   @default(active)
  targetDate    DateTime?    @db.Date
  position      Float        @default(0)
  milestones    Task[]
  achievedAt    DateTime?    @db.Timestamptz(3)
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)

  @@index([workspaceId, status])
}

// ───────────────────────── Recurring / seasonal reminders ─────────────────────────

// "Replace HVAC filter every 3 months", "Clean gutters each October", "Quarterly
// estimated taxes". Not calendar events: the reminder job creates one Task per
// occurrence, `leadDays` before it's due, with (recurringReminderId, occurrenceDate)
// as the idempotency key.
model RecurringReminder {
  id                    String       @id @default(uuid()) @db.Uuid
  workspaceId           String       @db.Uuid
  workspace             Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title                 String
  notes                 String?
  category              String? // "home", "car", "health", "school", "finance"… (template-suggested)
  rrule                 String // RFC 5545 RRULE, e.g. "FREQ=YEARLY;BYMONTH=10;BYMONTHDAY=15"
  leadDays              Int          @default(7)
  taskListId            String?      @db.Uuid // generated tasks land on this list (e.g. Honey-do)
  taskList              TaskList?    @relation(fields: [taskListId], references: [id], onDelete: SetNull)
  assignedParticipantId String?      @db.Uuid
  assignedParticipant   Participant? @relation(fields: [assignedParticipantId], references: [id], onDelete: SetNull)
  enabled               Boolean      @default(true)
  tasks                 Task[]
  createdAt             DateTime     @default(now()) @db.Timestamptz(3)

  @@index([workspaceId, enabled])
}

// ───────────────────────── Photo extraction ─────────────────────────

enum ExtractionStatus {
  pending
  processing
  completed
  failed
}

model UploadedScheduleImage {
  id               String           @id @default(uuid()) @db.Uuid
  workspaceId      String           @db.Uuid
  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Object path inside the private Supabase Storage bucket (served via short-lived signed
  // URLs) — not a public URL, since these photos are often kids' schedules / client data.
  storagePath      String
  status           ExtractionStatus @default(pending)
  errorMessage     String?
  // Candidate events awaiting human confirmation — NOT Event rows yet.
  extractedEvents  Json?
  uploadedByUserId String?          @db.Uuid
  uploadedBy       User?            @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([workspaceId])
  @@index([status, updatedAt])
}

// ───────────────────────── Places, availability, travel ─────────────────────────

enum PlaceKind {
  home
  work
  school
  activity // field, gym, studio
  store
  other
}

model Place {
  id                   String         @id @default(uuid()) @db.Uuid
  workspaceId          String         @db.Uuid
  workspace            Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name                 String // "Home", "Eastside Park", "Target — Main St"
  kind                 PlaceKind      @default(other)
  address              String?
  latitude             Float
  longitude            Float
  googlePlaceId        String?
  // [{ dayOfWeek, startMinute, endMinute }] in the workspace's time zone; null = always open.
  // Errands are only planned inside these. Can be filled from Google Places later.
  openingHours         Json?
  // Minutes to park and walk in; added to drive time. Big venues/schools need more.
  arrivalBufferMinutes Int            @default(5)
  homeOf               Participant[]  @relation("ParticipantHome")
  events               Event[]
  tasks                Task[]
  shoppingLists        ShoppingList[]
  createdAt            DateTime       @default(now()) @db.Timestamptz(3)

  @@index([workspaceId])
}

// When a person is free for the organizer to plan tasks, in the workspace's time zone
// (e.g. Sat 09:00–17:00, weeknights 18:30–20:30). Several windows per day are fine.
model AvailabilityWindow {
  id            String      @id @default(uuid()) @db.Uuid
  participantId String      @db.Uuid
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  dayOfWeek     Int // 0 = Sunday … 6 = Saturday
  startMinute   Int // minutes after local midnight
  endMinute     Int

  @@index([participantId])
}

enum DepartureAlertStatus {
  scheduled // leave-by computed, traffic will be re-checked
  notified // "time to leave" sent
  skipped // no origin/place, or the event was cancelled
}

// One per (event, driver). The departure job re-checks traffic as the event approaches
// and moves leaveBy; `notifiedAt` makes the warning fire once.
model DepartureAlert {
  id                 String               @id @default(uuid()) @db.Uuid
  eventId            String               @db.Uuid
  event              Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  participantId      String               @db.Uuid // the driver
  participant        Participant          @relation(fields: [participantId], references: [id], onDelete: Cascade)
  originLabel        String // "Home", or the previous event's place
  originLatitude     Float
  originLongitude    Float
  leaveBy            DateTime             @db.Timestamptz(3)
  trafficMinutes     Int
  typicalMinutes     Int // no-traffic baseline, for "8 min longer than usual"
  nextCheckAt        DateTime?            @db.Timestamptz(3)
  lastCheckedAt      DateTime             @db.Timestamptz(3)
  // What this leave-by was computed for; if the event's time or place changes, recompute
  // (compared by value, not by clock, so worker/DB clock skew can't hide a change).
  computedForStart   DateTime             @default(now()) @db.Timestamptz(3)
  computedForPlaceId String?              @db.Uuid
  notifiedAt         DateTime?            @db.Timestamptz(3)
  status             DepartureAlertStatus @default(scheduled)
  createdAt          DateTime             @default(now()) @db.Timestamptz(3)

  @@unique([eventId, participantId])
  @@index([status, nextCheckAt])
}

// ───────────────────────── Notifications ─────────────────────────

enum NotificationChannel {
  in_app // the dashboard's bell; always delivered
  web_push
  sms
  email
}

// Outbox: jobs write rows here, a sender delivers them. `dedupeKey` (e.g.
// "leave:<alertId>") stops a job re-run from double-notifying.
model Notification {
  id          String              @id @default(uuid()) @db.Uuid
  userId      String              @db.Uuid
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String              @db.Uuid
  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel     NotificationChannel
  title       String
  body        String
  url         String? // deep link into the app
  sendAt      DateTime            @db.Timestamptz(3)
  sentAt      DateTime?           @db.Timestamptz(3)
  readAt      DateTime?           @db.Timestamptz(3)
  kind        String              @default("general") // "leave_by", "leave_earlier", …
  error       String?
  dedupeKey   String
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)

  @@unique([userId, dedupeKey, channel])
  @@index([sentAt, sendAt])
}

// ───────────────────────── OAuth (Google Calendar) ─────────────────────────

enum OAuthProvider {
  google
}

enum OAuthConnectionStatus {
  active
  needs_reauth // refresh token revoked/expired: syncs pause until the person reconnects
}

// One per (workspace, external account). Belongs to the person who connected it: only
// they can browse that account's calendar list and pick calendars from it, because it's
// *their* Google account (others in the workspace just see the chosen calendars' events).
model OAuthConnection {
  id                String                @id @default(uuid()) @db.Uuid
  workspaceId       String                @db.Uuid
  workspace         Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connectedByUserId String                @db.Uuid
  connectedBy       User                  @relation(fields: [connectedByUserId], references: [id], onDelete: Cascade)
  provider          OAuthProvider
  providerAccountId String // Google "sub"
  accountEmail      String
  // AES-256-GCM ciphertext (app-layer, key from env) — never plaintext.
  accessTokenEnc    Bytes
  refreshTokenEnc   Bytes
  tokenExpiresAt    DateTime              @db.Timestamptz(3)
  scopes            String
  status            OAuthConnectionStatus @default(active)
  sources           CalendarSource[]
  createdAt         DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @db.Timestamptz(3)

  @@unique([workspaceId, provider, providerAccountId])
}

// In-flight OAuth handshakes: single-use, 10-minute life. `state` ties the callback to
// the person and workspace that started it (stops login-CSRF / mix-up attacks); the PKCE
// verifier proves the code exchange comes from us.
model OAuthState {
  id           String        @id @default(uuid()) @db.Uuid
  stateHash    String        @unique
  codeVerifier String
  provider     OAuthProvider
  userId       String        @db.Uuid
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId  String        @db.Uuid
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  expiresAt    DateTime      @db.Timestamptz(3)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
}

// A browser/phone that asked for push notifications (Web Push, VAPID). One person can
// have several devices; dead endpoints (404/410 from the push service) are deleted.
model PushSubscription {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  lastUsedAt DateTime? @db.Timestamptz(3)

  @@index([userId])
}
